# --- Секреты ---
.env
.env.*
!.env.example
*.key
*.pem
.claude/settings.local.json

# --- Данные заказчика (НЕ коммитим: коммерческая информация и вес) ---
# Прайс-лист с ценами
Pricelist*.xlsx
~$*.xlsx
# PDF-каталоги (78 МБ)
*.pdf

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Данные приложения (генерируются, содержат ПДн клиентов) ---
data/kb/
data/raw/
data/*.sqlite3
data/orders.jsonl
data/dialogs/
secrets/

# --- Внутренние документы (коммерческая информация заказчика) ---
# Полная версия плана: содержит статистику по остаткам, детали интеграции
# с сайтом и оценку текущего состояния заказчика по ФЗ-152.
# Публичная обезличенная версия — ПЛАН.md
ПЛАН_ПОЛНЫЙ.md
ВОПРОСЫ_ЗАКАЗЧИКУ.txt
Копия Вебинар*.md

# Сохранённые страницы сайта заказчика: внутренние поля CMS, названия и цены.
# Общее правило, чтобы такой файл не попал в публичный репозиторий случайно.
*.html
# Наша собственная разметка — часть исходников и коммитится.
!src/web/static/*.html

# --- Служебное ---
# Артефакт сборки setuptools.
src/*.egg-info/
# Настройки агентских инструментов, к проекту отношения не имеют.
.claude/
# Разовые диагностические скрипты рядом с данными.
data/*.py

# --- Прочее ---
.DS_Store
Thumbs.db
.idea/
# Настройки VS Code — часть проекта: конфигурации запуска и задачи нужны всем,
# кто откроет репозиторий. Личные файлы редактора при этом не коммитятся.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
*.log
