{
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["src"],
  "python.envFile": "${workspaceFolder}/.env",
  "files.encoding": "utf8",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "[python]": {
    "editor.formatOnSave": false,
    "editor.rulers": [100]
  }
}
