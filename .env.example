# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Каталог ---------------------------------------------------------------
# Собирается командой: python run.py ingest --source data/raw/<выгрузка>.xlsx
KB_PATH=data/kb/products.jsonl
STORAGE_PATH=data/vdm.sqlite3

# --- Cloud.ru Foundation Models --------------------------------------------
# Ключ сервисного аккаунта. Пока пусто — бот работает без модели: отвечает
# поиском по каталогу, корзина и заказ при этом полностью рабочие.
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200

# --- Каналы ----------------------------------------------------------------
TELEGRAM_TOKEN=
# Токен MAX выдаётся после верификации юрлица — до этого канал выключен.
MAX_TOKEN=
SITE_URL=https://vdm.ru
MANAGER_CONTACT=+7 (495) 646-01-40, elti@vdm.ru

# --- Куда уходит заказ -----------------------------------------------------
# jsonl — локальный файл (по умолчанию, ничего не требует)
# google_sheets — таблица вместо CRM, пока нет доступа к CRM
# bitrix24 — заглушка, включится с вебхуком заказчика
ORDER_SINK=jsonl
ORDERS_JSONL_PATH=data/orders.jsonl
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_FILE=secrets/google-service-account.json

# --- Фотографии товаров ----------------------------------------------------
# В выгрузке 1С изображений нет, они добираются со страниц сайта и попадают
# в базу знаний (поле images в products.jsonl).
# Весь каталог:  python run.py media
# Проба:         python run.py media --cards 20
# Прогрев по разделу: python run.py media --listing <адрес списка> --cards 0
MEDIA_ENABLED=1
# Пауза между запросами к сайту. Не поднимать: vdm.ru — рабочий сайт.
MEDIA_MIN_INTERVAL=1.0
# robots.txt написан для поисковых роботов, бот делается для владельца сайта.
MEDIA_RESPECT_ROBOTS=0
# Только латиница: кириллица в заголовке HTTP роняет запрос.
MEDIA_USER_AGENT=

# --- Журнал диалогов (сырьё для доработки промптов) -------------------------
# Пишется по суткам в JSONL. Персональные данные обезличиваются перед записью,
# ответы на вопросы о контактах не пишутся вовсе.
# Просмотр: python run.py dialogs --last 20
# Выгрузка: python run.py dialogs --last 50 --export dialogs.md
DIALOG_LOG_ENABLED=1
DIALOG_LOG_PATH=data/dialogs
DIALOG_LOG_MASK_PDN=1

# --- Виджет ----------------------------------------------------------------
# Домены, которым разрешено обращаться к виджету. Боевой сайт добавляется сюда.
WIDGET_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WIDGET_HOST=0.0.0.0
WIDGET_PORT=8000
